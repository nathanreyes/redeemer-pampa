{
  "name": "redeemer-pampa",
  "version": "2.0.0",
  "description": "Website for Redeemer Pampa, a church in Pampa, TX, aligned with the Redeemer Network.",
  "author": "Nathan Reyes <nathanreyes@me.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "content": "node util/buildSiteContent.js",
    "deploy": "npm run generate && wrangler deploy",
    "cron:deploy": "wrangler deploy --config workers/rebuild/wrangler.jsonc",
    "cron:secret": "wrangler secret put DEPLOY_HOOK_URL --config workers/rebuild/wrangler.jsonc",
    "cron:tail": "wrangler tail --config workers/rebuild/wrangler.jsonc"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3"
  },
  "devDependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "dashify": "^2.0.0",
    "fast-xml-parser": "^5.10.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.123.0"
  }
}
